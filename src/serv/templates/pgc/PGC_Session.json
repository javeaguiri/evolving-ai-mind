{
  "table_name": "PGC_Session",
  "target": "pgc",
  "description": "One row per LLM session: minds_eye, general_chat and llm_call_diagnostic sessions. query_id is the user-facing reference used with /explain. callback is where the session's messages go, the shape of PGC_WorkflowRun.callback; topic is set only from the minds_eye panel that starts the session; label is the session's name as the person set it (null: named by its first message).",
  "columns": [
    { "name": "id",              "type": "serial",        "primaryKey": true },
    { "name": "session_type",    "type": "varchar(30)",   "nullable": false },
    { "name": "query_id",        "type": "uuid",          "nullable": false, "unique": true, "default": "gen_random_uuid()" },
    { "name": "workflow_name",   "type": "varchar(100)",  "nullable": true },
    { "name": "run_id",          "type": "integer",       "nullable": true },
    { "name": "trace_id",        "type": "varchar(100)",  "nullable": true },
    { "name": "step_id",         "type": "varchar(50)",   "nullable": true },
    { "name": "intent_category", "type": "varchar(100)",  "nullable": true },
    { "name": "created_at",      "type": "timestamptz",   "nullable": false, "default": "now()" },
    { "name": "minds_eye_turn_count",   "type": "integer", "nullable": true },
    { "name": "minds_eye_action_count", "type": "integer", "nullable": true },
    { "name": "request_fingerprint",      "type": "jsonb",   "nullable": true },
    { "name": "fingerprint_hash",         "type": "text",    "nullable": true },
    { "name": "response_source",          "type": "text",    "nullable": true },
    { "name": "replayed_from_session_id", "type": "integer", "nullable": true },
    { "name": "callback",                 "type": "jsonb",   "nullable": true },
    { "name": "topic",                    "type": "text",    "nullable": true },
    { "name": "label",                    "type": "text",    "nullable": true }
  ],
  "foreign_keys": [],
  "constraints": [
    { "type": "check", "name": "chk_pgc_session_type", "expression": "session_type IN ('general_chat', 'llm_call_diagnostic', 'minds_eye')" },
    { "type": "check", "name": "chk_pgc_session_turn_ceiling", "expression": "minds_eye_turn_count IS NULL OR minds_eye_turn_count <= 100" },
    { "type": "check", "name": "chk_pgc_session_response_source", "expression": "response_source IS NULL OR response_source IN ('live', 'replayed', 'recorded')" }
  ],
  "triggers": []
}
