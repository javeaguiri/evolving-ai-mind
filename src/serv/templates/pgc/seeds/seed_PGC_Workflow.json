[
  {
    "name": "create_domain",
    "domain": null,
    "description": "Designs and creates a new user domain. LLM proposes a schema. User reviews, optionally adds tables, and confirms. DDL is executed, CRUD workflows are generated, and the domain is registered and immediately usable from /mind.",
    "intent_keywords": [
      "create domain",
      "new domain",
      "build domain",
      "add domain"
    ],
    "state_strategy": "sequential_with_confirmation",
    "model_used": "anthropic/claude-sonnet-4-5",
    "version": 3,
    "steps": [
      {
        "step": "1",
        "type": "llm_call",
        "description": "LLM designs full domain schema. Must produce one primary table (no FK references) and zero or more child tables referencing it.",
        "input": {
          "prompt": "create_domain",
          "user_input": "{{input.userInput}}"
        },
        "output_key": "proposed_scaffold",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "2",
        "type": "js_transform",
        "transform_type": "columnSummary",
        "description": "Enrich each table with columnSummary (display) and domain field (fixes domain:null on DDL rows).",
        "input_key": "proposed_scaffold.tables",
        "output_key": "proposed_scaffold.tables",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "3",
        "type": "human_gate",
        "gate_type": "edit_list",
        "description": "User reviews proposed table list. Child tables may be removed. User may also add a table.",
        "message_template": "Here's my plan for domain {{proposed_scaffold.domain}}. You can remove child tables you don't need, or add one that's missing.",
        "context_key": "proposed_scaffold.tables",
        "item_primary_key": "tableName",
        "item_secondary_key": "columnSummary",
        "item_action": {
          "condition": "item.foreignKeys && item.foreignKeys.length > 0",
          "action": "remove_item",
          "action_data_key": "tableName",
          "confirm_template": "Remove {{item.tableName}} from this domain?"
        },
        "options": [
          {
            "label": "Looks good",
            "action": "confirm",
            "on_select": "step:3d"
          },
          {
            "label": "Add a table",
            "action": "add_table",
            "on_select": "step:3a"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "3a",
        "type": "human_gate",
        "gate_type": "text_input",
        "description": "User describes the table they want to add.",
        "message_template": "Describe the table you want to add — what it stores and how it relates to the other tables.",
        "options": [
          {
            "label": "Submit",
            "action": "confirm",
            "on_select": "next"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "output_key": "new_table_description",
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "3b",
        "type": "llm_call",
        "description": "LLM designs the new table from user description.",
        "input": {
          "prompt": "design_table",
          "domain": "{{proposed_scaffold.domain}}",
          "existing_tables": "{{proposed_scaffold.tables}}",
          "user_input": "{{new_table_description}}"
        },
        "output_key": "new_table",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "3c",
        "type": "js_transform",
        "transform_type": "columnSummary",
        "description": "Merge new table into proposed_scaffold.tables and re-enrich. on_success loops back to step 3.",
        "input_key": "proposed_scaffold.tables",
        "output_key": "proposed_scaffold.tables",
        "on_success": "step:3",
        "on_failure": "human_feedback"
      },
      {
        "step": "3d",
        "type": "human_gate",
        "gate_type": "review_object",
        "description": "User reviews the full column details of all tables before DDL is executed.",
        "message_template": "Here are the full details for all tables in domain {{proposed_scaffold.domain}}. Review the columns before we create them.",
        "context_key": "proposed_scaffold.tables",
        "options": [
          {
            "label": "Looks good",
            "action": "confirm",
            "on_select": "next"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "4",
        "type": "human_gate",
        "gate_type": "confirm",
        "description": "Final confirmation before DDL execution.",
        "message_template": "Ready to create domain {{proposed_scaffold.domain}} with {{proposed_scaffold.tables.length}} tables. This will create the physical database tables.",
        "options": [
          {
            "label": "Create it",
            "action": "confirm",
            "on_select": "next"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "5",
        "type": "iterator",
        "description": "Create each confirmed PGD table via SERV-Schema createTable. Each table object carries domain field so PGC_Schema rows have domain populated.",
        "items_key": "proposed_scaffold.tables",
        "item_step": {
          "type": "serv_schema",
          "input": "{{item}}",
          "on_failure": "human_feedback"
        },
        "execution_mode": "sequential",
        "output_key": "created_tables",
        "on_complete": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "6",
        "type": "llm_call",
        "description": "LLM generates domainHelp (aliases, commands) and 4 CRUD workflow definitions from the confirmed scaffold. Returns { domainHelp, workflows, intentMapRows }.",
        "input": {
          "prompt": "generate_crud_workflows",
          "domain": "{{proposed_scaffold.domain}}",
          "tables": "{{proposed_scaffold.tables}}"
        },
        "output_key": "generated",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "7",
        "type": "human_gate",
        "gate_type": "review_object",
        "description": "User reviews and confirms aliases and CRUD commands before they are written to PGC_DomainHelp.",
        "message_template": "Almost done. Here are the aliases and commands I'll register for your domain. Confirm to proceed.",
        "context_key": "generated.domainHelp",
        "options": [
          {
            "label": "Looks good",
            "action": "confirm",
            "on_select": "next"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "output_key": "confirmed_domain_help",
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "8",
        "type": "serv_insert",
        "description": "Write confirmed domain aliases and commands to PGC_DomainHelp.",
        "input": {
          "tableName": "PGC_DomainHelp",
          "row": "{{confirmed_domain_help}}"
        },
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "9",
        "type": "iterator",
        "description": "Insert each of the 4 generated CRUD workflows into PGC_Workflow.",
        "items_key": "generated.workflows",
        "item_step": {
          "type": "serv_insert",
          "input": {
            "tableName": "PGC_Workflow",
            "row": "{{item}}"
          },
          "on_failure": "human_feedback"
        },
        "execution_mode": "sequential",
        "output_key": "registered_workflows",
        "on_complete": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "10",
        "type": "iterator",
        "description": "Insert each of the 4 generated PGC_IntentMap rows.",
        "items_key": "generated.intentMapRows",
        "item_step": {
          "type": "serv_insert",
          "input": {
            "tableName": "PGC_IntentMap",
            "row": "{{item}}"
          },
          "on_failure": "human_feedback"
        },
        "execution_mode": "sequential",
        "output_key": "registered_intent_rows",
        "on_complete": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "11",
        "type": "notify",
        "description": "Confirm domain creation with concrete command examples.",
        "message_template": "Domain {{proposed_scaffold.domain}} is ready with {{proposed_scaffold.tables.length}} tables and 4 CRUD workflows.\n\nTry:\n/mind list my {{proposed_scaffold.domain}}\n/mind add my {{proposed_scaffold.domain}} <field>=<value>\n/mind update my {{proposed_scaffold.domain}} id=<number> <field>=<value>\n/mind delete my {{proposed_scaffold.domain}} id=<number>",
        "on_success": "end"
      },
      {
        "step": "12",
        "type": "end"
      }
    ]
  },
  {
    "name": "help",
    "domain": null,
    "description": "Presents a welcome gate to the user and posts a summary of available commands after confirmation.",
    "intent_keywords": [
      "help",
      "what can you do",
      "commands",
      "show help"
    ],
    "state_strategy": "sequential_with_confirmation",
    "model_used": null,
    "version": 1,
    "steps": [
      {
        "step": "1",
        "type": "human_gate",
        "gate_type": "confirm",
        "description": "Ask user if they want to see available commands.",
        "message_template": "👋 Welcome to evolving-mind!\n\nI can help you build and manage data domains using natural language. Want to see what I can do?",
        "options": [
          {
            "label": "Yes, show me",
            "action": "confirm",
            "on_select": "next"
          },
          {
            "label": "Not now",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "2",
        "type": "notify",
        "description": "Post available commands to the user.",
        "message_template": "✅ Here's what evolving-mind can do:\n\n• `/create-domain <description>` — design and build a new data domain\n• `/help` — show this message\n\nMore commands coming as the brain evolves 🧠",
        "on_success": "end"
      },
      {
        "step": "3",
        "type": "end"
      }
    ]
  },
  {
    "name": "create_workflow",
    "domain": null,
    "description": "Stub — designs and stores a new reusable workflow in PGC_Workflow from a natural language description. Full step definition to be implemented in Phase 3.",
    "intent_keywords": [
      "create workflow",
      "new workflow",
      "build workflow",
      "add workflow"
    ],
    "state_strategy": "sequential_with_confirmation",
    "model_used": null,
    "version": 1,
    "steps": []
  }
]