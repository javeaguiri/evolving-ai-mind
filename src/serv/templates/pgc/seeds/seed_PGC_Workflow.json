[
  {
    "name": "create_domain",
    "domain": null,
    "description": "Designs and creates a new user domain. LLM proposes a schema. User reviews, optionally adds tables, and confirms. DDL is executed, CRUD workflows are generated, entity schemas are registered, and the domain is immediately usable from /mind.",
    "intent_keywords": [
      "create domain",
      "new domain",
      "build domain",
      "add domain"
    ],
    "state_strategy": "sequential_with_confirmation",
    "model_used": "anthropic/claude-sonnet-4-5",
    "version": 5,
    "steps": [
      {
        "step": "1",
        "type": "llm_call",
        "description": "LLM designs full domain schema. Must produce one primary table (no FK references) and zero or more child tables referencing it.",
        "input": {
          "prompt": "create_domain",
          "user_input": "{{input.userInput}}"
        },
        "output_key": "proposed_scaffold",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "2",
        "type": "js_transform",
        "transform_type": "columnSummary",
        "description": "Enrich each table with columnSummary (display) and domain field (fixes domain:null on DDL rows).",
        "input_key": "proposed_scaffold.tables",
        "output_key": "proposed_scaffold.tables",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "3",
        "type": "human_gate",
        "gate_type": "edit_list",
        "description": "User reviews proposed table list. Child tables may be removed. User may also add a table.",
        "message_template": "Here's my plan for domain {{proposed_scaffold.domain}}. You can remove child tables you don't need, or add one that's missing.",
        "context_key": "proposed_scaffold.tables",
        "item_primary_key": "tableName",
        "item_secondary_key": "columnSummary",
        "item_action": {
          "condition": "item.foreignKeys && item.foreignKeys.length > 0",
          "action": "remove_item",
          "action_data_key": "tableName",
          "confirm_template": "Remove {{item.tableName}} from this domain?"
        },
        "options": [
          {
            "label": "Looks good",
            "action": "confirm",
            "on_select": "step:3d"
          },
          {
            "label": "Add a table",
            "action": "add_table",
            "on_select": "step:3a"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "3a",
        "type": "human_gate",
        "gate_type": "text_input",
        "description": "User describes the table they want to add.",
        "message_template": "Describe the table you want to add \u2014 what it stores and how it relates to the other tables.",
        "options": [
          {
            "label": "Submit",
            "action": "confirm",
            "on_select": "next"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "output_key": "new_table_description",
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "3b",
        "type": "llm_call",
        "description": "LLM designs the new table from user description.",
        "input": {
          "prompt": "design_table",
          "domain": "{{proposed_scaffold.domain}}",
          "existing_tables": "{{proposed_scaffold.tables}}",
          "user_input": "{{new_table_description}}"
        },
        "output_key": "new_table",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "3c",
        "type": "js_transform",
        "transform_type": "columnSummary",
        "description": "Merge new table into proposed_scaffold.tables and re-enrich. on_success loops back to step 3.",
        "input_key": "proposed_scaffold.tables",
        "output_key": "proposed_scaffold.tables",
        "on_success": "step:3",
        "on_failure": "human_feedback"
      },
      {
        "step": "3d",
        "type": "human_gate",
        "gate_type": "review_object",
        "description": "User reviews the full column details of all tables before DDL is executed.",
        "message_template": "Here are the full details for all tables in domain {{proposed_scaffold.domain}}. Review the columns before we create them.",
        "context_key": "proposed_scaffold.tables",
        "options": [
          {
            "label": "Looks good",
            "action": "confirm",
            "on_select": "next"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "4",
        "type": "human_gate",
        "gate_type": "confirm",
        "description": "Final confirmation before DDL execution.",
        "message_template": "Ready to create domain {{proposed_scaffold.domain}} with {{proposed_scaffold.tables.length}} tables. This will create the physical database tables.",
        "options": [
          {
            "label": "Create it",
            "action": "confirm",
            "on_select": "next"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "5",
        "type": "iterator",
        "description": "Create each confirmed PGD table via SERV-Schema createTable. Each table object carries domain field so PGC_Schema rows have domain populated.",
        "items_key": "proposed_scaffold.tables",
        "item_step": {
          "type": "serv_schema",
          "input": "{{item}}",
          "on_failure": "human_feedback"
        },
        "execution_mode": "sequential",
        "output_key": "created_tables",
        "on_complete": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "6",
        "type": "llm_call",
        "description": "LLM generates domainHelp (aliases, commands), 4 CRUD workflow definitions, and entity schema definitions from the confirmed scaffold. Returns { domainHelp, workflows, intentMapRows, entitySchemas }.",
        "input": {
          "prompt": "generate_crud_workflows",
          "domain": "{{proposed_scaffold.domain}}",
          "tables": "{{proposed_scaffold.tables}}"
        },
        "output_key": "generated",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "7",
        "type": "human_gate",
        "gate_type": "review_object",
        "description": "User reviews and confirms aliases and CRUD commands before they are written to PGC_DomainHelp.",
        "message_template": "Almost done. Here are the aliases and commands I'll register for your domain. Confirm to proceed.",
        "context_key": "generated.domainHelp",
        "options": [
          {
            "label": "Looks good",
            "action": "confirm",
            "on_select": "next"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "8",
        "type": "serv_insert",
        "description": "Write confirmed domain aliases and commands to PGC_DomainHelp.",
        "input": {
          "tableName": "PGC_DomainHelp",
          "row": "{{generated.domainHelp}}"
        },
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "9",
        "type": "iterator",
        "description": "Insert the 5 PGC_IntentMap rows generated by the LLM. intent_category values are *_entity (generic) \u2014 the prompt produces these directly.",
        "items_key": "generated.intentMapRows",
        "item_step": {
          "type": "serv_insert",
          "input": {
            "tableName": "PGC_IntentMap",
            "row": "{{item}}"
          },
          "on_failure": "human_feedback"
        },
        "execution_mode": "sequential",
        "output_key": "registered_intent_rows",
        "on_complete": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "10b",
        "type": "iterator",
        "description": "Register each generated entity schema in PGC_EntitySchema so SERV-Entity can serve multi-table queries for this domain.",
        "items_key": "generated.entitySchemas",
        "item_step": {
          "type": "serv_insert",
          "input": {
            "tableName": "PGC_EntitySchema",
            "row": "{{item}}"
          },
          "on_failure": "human_feedback"
        },
        "execution_mode": "sequential",
        "output_key": "registered_entities",
        "on_complete": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "11",
        "type": "notify",
        "description": "Confirm domain creation with concrete command examples.",
        "message_template": "Domain {{proposed_scaffold.domain}} is ready with {{proposed_scaffold.tables.length}} tables.\n\nTry:\n\u2022 /m list {{proposed_scaffold.domain}}\n\u2022 /m get {{proposed_scaffold.domain}} <name>\n\u2022 /m add {{proposed_scaffold.domain}} <description>\n\u2022 /m update {{proposed_scaffold.domain}} id=<number> <field>=<value>\n\u2022 /m delete {{proposed_scaffold.domain}} id=<number>",
        "on_success": "end"
      },
      {
        "step": "12",
        "type": "end"
      }
    ]
  },
  {
    "name": "help",
    "domain": null,
    "description": "Interactive help \u2014 shows system commands or live domain help. Queries PGC_DomainHelp at runtime so the list grows as domains are added.",
    "intent_keywords": [
      "help",
      "what can you do",
      "commands",
      "show help"
    ],
    "state_strategy": "sequential_with_confirmation",
    "model_used": null,
    "version": 2,
    "steps": [
      {
        "step": "1",
        "type": "serv_query",
        "description": "Load all registered domain help entries so domain buttons are live data.",
        "input": {
          "tableName": "PGC_DomainHelp",
          "orderBy": {
            "column": "domain",
            "direction": "asc"
          }
        },
        "output_key": "registered_domains",
        "on_success": "next",
        "on_failure": "next"
      },
      {
        "step": "2",
        "type": "js_transform",
        "transform_type": "buildHelpOptions",
        "description": "Build per-domain button list and domain lookup map from query results.",
        "input_key": "registered_domains",
        "output_key": "help_options",
        "on_success": "next",
        "on_failure": "next"
      },
      {
        "step": "3",
        "type": "human_gate",
        "gate_type": "confirm",
        "description": "Level 1 \u2014 What would you like help with? System commands or a specific domain.",
        "message_template": "What would you like help with?",
        "context_key": "help_options.domainButtons",
        "output_key": "help_selection",
        "options": [
          {
            "label": "System commands",
            "action": "system",
            "on_select": "next"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "4",
        "type": "js_transform",
        "transform_type": "resolveHelpContent",
        "description": "Resolve the selected topic (system or domain name) into formatted help text.",
        "selection_key": "help_selection",
        "domain_map_key": "help_options.domainMap",
        "system_key": "system",
        "output_key": "resolved_help",
        "on_success": "next",
        "on_failure": "next"
      },
      {
        "step": "5",
        "type": "human_gate",
        "gate_type": "confirm",
        "description": "Level 2 \u2014 Display the resolved help content as the gate message. User can go back to the topic selector or dismiss.",
        "message_template": "{{resolved_help.content}}",
        "options": [
          {
            "label": "Done",
            "action": "confirm",
            "on_select": "next"
          },
          {
            "label": "Go back",
            "action": "back",
            "on_select": "step:3"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "6",
        "type": "end"
      }
    ]
  },
  {
    "name": "create_workflow",
    "domain": null,
    "description": "Designs and stores a new reusable workflow in PGC_Workflow from a natural language description. Classifies intent, generates steps, simulates, and registers the workflow so it is immediately available to the Intent Preprocessor.",
    "intent_keywords": [
      "create workflow",
      "new workflow",
      "build workflow",
      "add workflow",
      "make a workflow",
      "define a workflow"
    ],
    "state_strategy": "sequential_with_confirmation",
    "model_used": "anthropic/claude-sonnet-4-5",
    "version": 2,
    "steps": [
      {
        "step": "1",
        "type": "llm_call",
        "description": "Classify the workflow intent \u2014 extract domain, operation_type, target_tables, and a one-sentence description.",
        "input": {
          "prompt": "classify_workflow_intent",
          "userIntent": "{{input.userIntent}}",
          "domain": "{{input.domain}}"
        },
        "output_key": "workflow_intent",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "2",
        "type": "llm_call",
        "description": "Generate the workflow step array. Injects live PGC_StepType contracts and the create_domain worked example from PGC_SystemContext at prompt build time.",
        "input": {
          "prompt": "generate_workflow_steps",
          "workflow_intent": "{{workflow_intent}}",
          "domain_schema": "{{input.domain_schema}}"
        },
        "output_key": "draft_workflow",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "3",
        "type": "human_gate",
        "gate_type": "review_object",
        "description": "User reviews the proposed step array before simulation. Can request changes (routes back to step 2) or cancel.",
        "message_template": "Review the proposed steps for {{draft_workflow.name}}. Approve to simulate, or request changes to regenerate.",
        "context_key": "draft_workflow.steps",
        "options": [
          {
            "label": "Looks good",
            "action": "confirm",
            "on_select": "next"
          },
          {
            "label": "Request changes",
            "action": "request_changes",
            "on_select": "step:2"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "4",
        "type": "simulate",
        "description": "Level 1 static analysis only \u2014 no mocks needed. Validates routing values, dead targets, missing templates, and gate structure.",
        "input": {
          "steps_key": "draft_workflow.steps"
        },
        "output_key": "static_analysis_result",
        "on_success": "next",
        "on_failure": "step:3"
      },
      {
        "step": "5",
        "type": "llm_call",
        "description": "Generate representative mock outputs for each step that produces data. Used as simulation inputs in Level 2 path execution.",
        "input": {
          "prompt": "generate_workflow_mocks",
          "steps": "{{draft_workflow.steps}}"
        },
        "output_key": "mock_outputs",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "6",
        "type": "llm_call",
        "description": "Generate named simulation paths \u2014 happy path, cancel paths per gate, failure paths per llm_call and serv_* step.",
        "input": {
          "prompt": "generate_workflow_paths",
          "steps": "{{draft_workflow.steps}}",
          "mock_outputs": "{{mock_outputs}}"
        },
        "output_key": "simulation_paths",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "7",
        "type": "simulate",
        "description": "Level 2 + Level 3 \u2014 full path execution using mock outputs and decision scripts. Validates data flow, template resolution, and terminal states.",
        "input": {
          "steps_key": "draft_workflow.steps",
          "mock_outputs_key": "mock_outputs",
          "paths_key": "simulation_paths"
        },
        "output_key": "simulation_result",
        "on_success": "next",
        "on_failure": "step:3"
      },
      {
        "step": "8",
        "type": "human_gate",
        "gate_type": "confirm",
        "description": "Show simulation results and ask user to confirm registration.",
        "message_template": "Simulation passed {{simulation_result.paths_passed}} of {{simulation_result.paths_run}} paths. Ready to register {{draft_workflow.name}}?",
        "options": [
          {
            "label": "Register",
            "action": "confirm",
            "on_select": "next"
          },
          {
            "label": "Cancel",
            "action": "cancel",
            "on_select": "cancel"
          }
        ],
        "on_success": "next",
        "on_failure": "cancel"
      },
      {
        "step": "9",
        "type": "serv_insert",
        "description": "Write the new workflow to PGC_Workflow.",
        "input": {
          "tableName": "PGC_Workflow",
          "row": {
            "name": "{{draft_workflow.name}}",
            "domain": "{{workflow_intent.domain}}",
            "description": "{{draft_workflow.description}}",
            "intent_keywords": "{{draft_workflow.intent_keywords}}",
            "steps": "{{draft_workflow.steps}}",
            "state_strategy": "sequential_with_confirmation",
            "version": 1
          }
        },
        "output_key": "registered_workflow",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "10",
        "type": "serv_insert",
        "description": "Write the PGC_IntentMap row so the new workflow is immediately matchable by the Intent Preprocessor Pass 1a regex.",
        "input": {
          "tableName": "PGC_IntentMap",
          "row": {
            "pattern": "{{draft_workflow.name}}",
            "intent_category": "{{draft_workflow.name}}",
            "workflow_id": "{{registered_workflow.id}}",
            "action_type": "workflow"
          }
        },
        "output_key": "registered_intent_row",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "11",
        "type": "notify",
        "description": "Confirm the workflow is registered and ready.",
        "message_template": "Workflow {{draft_workflow.name}} is registered and ready.\n\nTry: /mind {{draft_workflow.description}}",
        "on_success": "end"
      },
      {
        "step": "12",
        "type": "end"
      }
    ]
  },
  {
    "name": "get_entity",
    "domain": null,
    "description": "Find and display a domain entity record by id or name search including all child data. Generic \u2014 works for any domain. Requires input.entity_name and either input.id (exact lookup) or input.search (LIKE filter).",
    "intent_keywords": [
      "get",
      "show",
      "find",
      "fetch",
      "look up",
      "search"
    ],
    "state_strategy": "sequential",
    "model_used": null,
    "version": 1,
    "steps": [
      {
        "step": "1",
        "type": "condition",
        "description": "Route to id lookup when input.id is set, otherwise fall through to name search.",
        "expression": "{{input.id}}",
        "on_truthy": "2",
        "on_falsy": "3"
      },
      {
        "step": "2",
        "type": "serv_entity_get",
        "description": "Fetch entity by exact id.",
        "input": {
          "entityName": "{{input.entity_name}}",
          "id": "{{input.id}}"
        },
        "output_key": "results",
        "on_success": "step:4",
        "on_failure": "human_feedback"
      },
      {
        "step": "3",
        "type": "serv_entity_query",
        "description": "Search for the entity by name using a LIKE filter on the primary display column.",
        "input": {
          "entityName": "{{input.entity_name}}",
          "filters": [
            {
              "column": "name",
              "op": "like",
              "value": "{{input.search}}"
            }
          ],
          "limit": 5
        },
        "output_key": "results",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "4",
        "type": "js_transform",
        "description": "Format matched entity with all root columns and child arrays into a readable Slack message.",
        "transform_type": "formatRecordList",
        "input_key": "results",
        "max_rows": 5,
        "output_key": "results_display",
        "on_success": "next"
      },
      {
        "step": "5",
        "type": "notify",
        "message_template": "{{results_display}}",
        "on_success": "end"
      },
      {
        "step": "6",
        "type": "end"
      }
    ]
  },
  {
    "name": "list_entity",
    "domain": null,
    "description": "List all records for a domain entity with root columns and ids. Generic \u2014 works for any domain. Requires input.entity_name.",
    "intent_keywords": [
      "list",
      "show all",
      "get all",
      "find all",
      "all"
    ],
    "state_strategy": "sequential",
    "model_used": null,
    "version": 1,
    "steps": [
      {
        "step": "1",
        "type": "serv_entity_query",
        "description": "List all entities ordered by name. Returns root and child columns \u2014 child arrays suppressed by root_only in step 2.",
        "input": {
          "entityName": "{{input.entity_name}}",
          "orderBy": {
            "column": "name",
            "direction": "asc"
          },
          "limit": 50
        },
        "output_key": "results",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "2",
        "type": "js_transform",
        "description": "Format list results \u2014 root columns only. Child arrays suppressed by root_only flag to keep list output concise.",
        "transform_type": "formatRecordList",
        "input_key": "results",
        "max_rows": 20,
        "root_only": true,
        "output_key": "results_display",
        "on_success": "next"
      },
      {
        "step": "3",
        "type": "notify",
        "message_template": "{{results_display}}",
        "on_success": "end"
      },
      {
        "step": "4",
        "type": "end"
      }
    ]
  },
  {
    "name": "add_entity",
    "domain": null,
    "description": "Add a new domain entity record from natural language input. LLM parses description into structured data. User confirms before DB write. Generic \u2014 works for any domain. Requires input.entity_name.",
    "intent_keywords": [
      "add",
      "create",
      "new",
      "insert"
    ],
    "state_strategy": "sequential_with_confirmation",
    "model_used": null,
    "version": 1,
    "steps": [
      {
        "step": "1",
        "type": "serv_query",
        "description": "Load entity schema for the target entity \u2014 provides join topology and child table relationships.",
        "input": {
          "tableName": "PGC_EntitySchema",
          "filters": [
            {
              "column": "entity_name",
              "op": "eq",
              "value": "{{input.entity_name}}"
            }
          ],
          "limit": 1
        },
        "output_key": "entity_schema_rows",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "2",
        "type": "js_transform",
        "description": "Combine PGC_EntitySchema join topology with live PGC_Schema column definitions. Single source of truth for the LLM.",
        "transform_type": "buildEntitySchema",
        "input_key": "entity_schema_rows.0",
        "output_key": "full_entity_schema",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "3",
        "type": "llm_call",
        "description": "Parse the user natural language description into a structured entity object using the full schema.",
        "input": {
          "prompt": "parse_entity_input",
          "userInput": "{{input.userInput}}",
          "full_entity_schema": "{{full_entity_schema}}"
        },
        "output_key": "parsed_entity",
        "on_success": "next",
        "on_failure": "human_feedback"
      },
      {
        "step": "4",
        "type": "human_gate",
        "description": "User reviews the parsed entity before any DB write.",
