{
  "table_name": "PGC_EditPolicy",
  "target": "pgc",
  "description": "What the web may change directly, one row per PGD_ table: columns ({ \"<col>\": true }) open to direct edits, add_rows and delete_rows. A table without a row, or a column not named, is read-only to direct edits. Checked by PROC on the direct path only; workflows never meet it. Columns the system maintains are never opened by any row.",
  "columns": [
    { "name": "id",          "type": "serial",      "primaryKey": true },
    { "name": "table_name",  "type": "text",        "nullable": false },
    { "name": "columns",     "type": "jsonb",       "nullable": false, "default": "'{}'::jsonb" },
    { "name": "add_rows",    "type": "boolean",     "nullable": false, "default": "false" },
    { "name": "delete_rows", "type": "boolean",     "nullable": false, "default": "false" },
    { "name": "created_at",  "type": "timestamptz", "nullable": false, "default": "now()" },
    { "name": "updated_at",  "type": "timestamptz", "nullable": false, "default": "now()" }
  ],
  "foreign_keys": [],
  "constraints": [
    { "type": "unique", "name": "uq_editpolicy_table_name", "columns": ["table_name"] }
  ],
  "triggers": [
    { "name": "trg_pgc_editpolicy_updated_at", "timing": "BEFORE UPDATE", "function": "set_updated_at()" }
  ]
}
