[
  {
    "page_key": "home",
    "title": "Home",
    "position": 0,
    "panels": [
      { "id": "budget-report", "kind": "summary",  "width": "1/2", "title": "Budget vs spending",
        "config": { "widget": "report", "workflow": "budget_vs_expense_report" } },
      { "id": "budget",        "kind": "workflow", "width": "1/2", "title": "Budget",
        "config": { "workflow": "edit_budget" } },
      { "id": "stock",         "kind": "records",  "width": "full", "title": "Stock",
        "config": { "source": "PGD_Inventory", "view": "list", "order_by": "name ASC",
                    "columns": ["name", "quantity", "unit"], "title_column": "name", "detail_columns": ["quantity", "unit"] } }
    ]
  },
  {
    "page_key": "money",
    "title": "Money",
    "position": 10,
    "panels": [
      { "id": "expenses",       "kind": "records",  "width": "full", "title": "Expenses",
        "config": { "source": "PGD_Expenses", "order_by": "date DESC",
                    "filter": [{ "column": "deleted_at", "op": "is_null" }],
                    "columns": ["date", "title",
                                { "name": "amount", "format": "currency", "currency_column": "currency" },
                                "currency", { "name": "category_id", "label": "Category" },
                                "payment_method"] } },
      { "id": "expense-flows",  "kind": "workflow", "width": "1/2",  "title": "Expenses and budget",
        "config": { "domain": "budgets_expenses" } },
      { "id": "budget-summary", "kind": "records",  "width": "1/2",  "title": "Budget and spending by category",
        "config": { "source": "PGD_BudgetExpenseSummary", "order_by": "year DESC, month DESC, category_name ASC", "limit": 50,
                    "columns": ["month",
                                { "name": "category_name", "label": "Category" },
                                "type",
                                { "name": "total_budgeted", "label": "Budgeted", "format": "currency", "currency": "EUR" },
                                { "name": "total_actual",   "label": "Spent",    "format": "currency", "currency": "EUR" },
                                { "name": "variance",                            "format": "currency", "currency": "EUR" }] } },
      { "id": "ask-money",      "kind": "minds_eye", "width": "1/2",
        "config": { "domain": "budgets_expenses" } }
    ]
  },
  {
    "page_key": "inventory",
    "title": "Inventory",
    "position": 20,
    "panels": [
      { "id": "inventory-flows", "kind": "workflow", "width": "full", "title": "Inventory workflows",
        "config": { "domain": "inventory" } },
      { "id": "items",           "kind": "records",  "width": "full", "title": "Items",
        "config": { "source": "PGD_Inventory", "order_by": "name ASC",
                    "columns": ["name", "quantity", "unit", { "name": "target_quantity", "label": "Target" }, "item_type"] } }
    ]
  }
]
